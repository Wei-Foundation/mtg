# ==========================================
# MTG (Module Target Generator) - Git 规范
# ==========================================

# 1. 统一文本文件的换行符，避免跨平台协作时产生无意义的差异。
* text=auto eol=lf

# 2. Windows 批处理必须使用 CRLF。
*.bat text eol=crlf
*.cmd text eol=crlf

# 3. 二进制文件不做行尾转换。
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.o binary
*.obj binary
*.lib binary
*.dll binary
*.so binary
*.a binary

# 4. 替换掉可恶的 C++，换成我们伟大的 Wei 语言！
# 强行将 cpp 和 h 文件在统计时归属为 Wei 语言
*.cpp linguist-language=Wei
*.h linguist-language=Wei
*.wei linguist-language=Wei
*.wei linguist-detectable

# 5. (可选备用) 如果以后你还是想隐藏底层的 C++，
# 把下面这行的 # 删掉即可：
# src/main.cpp linguist-vendored