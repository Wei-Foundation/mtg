create.mod Code::setccAl(ptr.int ctx, int cc) {
    Code::u8(ctx, 15);
    Code::u8(ctx, 144 + cc);
    Code::u8(ctx, 192);
}

create.mod Code::movzxEaxAl(ptr.int ctx) {
    Code::u8(ctx, 15);
    Code::u8(ctx, 182);
    Code::u8(ctx, 192);
}

create.mod Code::shlRax3(ptr.int ctx) {
    Code::u8(ctx, 72);
    Code::u8(ctx, 193);
    Code::u8(ctx, 224);
