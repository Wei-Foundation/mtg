}

create.mod Code::subRspPlaceholder(ptr.int ctx).int {
    Code::u8(ctx, 72);
    Code::u8(ctx, 129);
    Code::u8(ctx, 236);
    create.int pos = Ctx::get(ctx, 200);
    Code::u32(ctx, 0);
    return pos;
}

create.mod Code::addRspImm(ptr.int ctx, int v) {
    Code::u8(ctx, 72);
    Code::u8(ctx, 129);
    Code::u8(ctx, 196);
