                                                                                        } else {
                                                                                            return Lex::fail(ctx, 8);
                                                                                        }
                                                                                    } else {
                                                                                        return Lex::fail(ctx, 2);
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    Lex::take(ctx);
    if (len == 2) {
        Lex::take(ctx);
    }
    Ctx::set(ctx, 400, len);
    Ctx::set(ctx, 408, 0);
    Ctx::set(ctx, 416, 0);
    return Lex::putTok(ctx, base, k);
}

create.mod Lex::scanInto(ptr.int ctx, int base).int {
    Ctx::set(ctx, 424, base);
    Lex::skip(ctx);
    Ctx::set(ctx, 376, Ctx::get(ctx, 16));
    Ctx::set(ctx, 384, Ctx::get(ctx, 24));
    Ctx::set(ctx, 392, Ctx::get(ctx, 32));
    Ctx::set(ctx, 400, 0);
    Ctx::set(ctx, 408, 0);
    Ctx::set(ctx, 416, 0);
    create.int c = Src::byte(ctx, Ctx::get(ctx, 16));
    if (c == 0) {
        return Lex::putTok(ctx, base, 0);
    }
    if (c == 227) {
        create.int b1 = Src::byte(ctx, Ctx::get(ctx, 16) + 1);
        create.int b2 = Src::byte(ctx, Ctx::get(ctx, 16) + 2);
        if (b1 == 128) {
            if (b2 == 130) {
                Lex::take(ctx);
                Lex::take(ctx);
                Lex::take(ctx);
                return Lex::putTok(ctx, base, 39);
            }
            if (b2 == 140 || b2 == 143) {
                return Lex::scanCjkStr(ctx, base);
            }
            if (b2 == 129 || b2 == 128) {
                Lex::take(ctx);
                Lex::take(ctx);
                Lex::take(ctx);
                return Lex::scanInto(ctx, base);
            }
        }
    }
    if (c == 239) {
        create.int b1 = Src::byte(ctx, Ctx::get(ctx, 16) + 1);
        create.int b2 = Src::byte(ctx, Ctx::get(ctx, 16) + 2);
        if (b1 == 188) {
            if (b2 == 140) {
                Lex::take(ctx);
                Lex::take(ctx);
                Lex::take(ctx);
                return Lex::scanInto(ctx, base);
            }
            if (b2 == 154) {
                Lex::take(ctx);
                Lex::take(ctx);
                Lex::take(ctx);
                return Lex::putTok(ctx, base, 57);
            }
            if (b2 == 136) {
                Lex::take(ctx);
                Lex::take(ctx);
                Lex::take(ctx);
                return Lex::putTok(ctx, base, 34);
            }
            if (b2 == 137) {
                Lex::take(ctx);
                Lex::take(ctx);
                Lex::take(ctx);
                return Lex::putTok(ctx, base, 35);
            }
        }
    }
    if (Lex::isAlpha(c) == 1) {
        return Lex::scanIdent(ctx, base);
    }
    if (Lex::isCjkLead(c) == 1) {
        return Lex::scanCjkIdent(ctx, base);
    }
    if (Lex::isDigit(c) == 1) {
        return Lex::scanInt(ctx, base);
    }
    if (c == 34) {
        return Lex::scanStr(ctx, base);
    }
    return Lex::scanPunct(ctx, base, c);
}

create.mod Lex::init(ptr.int ctx, ptr.int src, int len) {
    Ctx::set(ctx, 0, Cast::num(src));
    Ctx::set(ctx, 8, len);
    Ctx::set(ctx, 16, 0);
    Ctx::set(ctx, 24, 1);
    Ctx::set(ctx, 32, 1);
    Ctx::set(ctx, 40, 0);
    Ctx::set(ctx, 64, 0);
    if (len >= 3) {
        if (Src::byte(ctx, 0) == 239 && Src::byte(ctx, 1) == 187 && Src::byte(ctx, 2) == 191) {
            Ctx::set(ctx, 16, 3);
        }
    }
    Lex::scanInto(ctx, 72);
    if (Ctx::get(ctx, 72) == 1) {
        Lex::copyTok(ctx, 128, 72);
    } else {
        Lex::scanInto(ctx, 128);
    }
}

create.mod Lex::next(ptr.int ctx).int {
    Lex::copyTok(ctx, 72, 128);
    create.int k = Ctx::get(ctx, 128);
    if (k != 0 && k != 1) {
        Lex::scanInto(ctx, 128);
    }
    return Ctx::get(ctx, 72);
}

create.mod Data::putRaw(ptr.int data, int off, char s).int {
    create.int i = 0;
    create.int c = __byte_at(s, 0);
    while (c != 0) {
        __store_byte(data, off + i, c);
        i = i + 1;
        c = __byte_at(s, i);
    }
    __store_byte(data, off + i, 0);
    return off + i + 1;
}

create.mod Data::init(ptr.int ctx, ptr.int data, int cap) {
    Ctx::set(ctx, 208, Cast::num(data));
    Ctx::set(ctx, 216, cap);
    Ctx::set(ctx, 224, 544);
    __store_byte(data, 512, 37);
    __store_byte(data, 513, 108);
    __store_byte(data, 514, 108);
    __store_byte(data, 515, 100);
    __store_byte(data, 516, 10);
    __store_byte(data, 517, 0);
    __store_byte(data, 528, 37);
    __store_byte(data, 529, 115);
    __store_byte(data, 530, 10);
    __store_byte(data, 531, 0);
    create.int p = 544;
    Ctx::set(ctx, 536, p);
    p = Data::putRaw(data, p, "runtime panic: division by zero");
    Ctx::set(ctx, 544, p);
    p = Data::putRaw(data, p, "runtime panic: array index out of bounds");
    Ctx::set(ctx, 552, p);
    p = Data::putRaw(data, p, "runtime panic: heap exhausted");
    Ctx::set(ctx, 224, p);
}

// ── Code buffer and fixups ──────────────────────────────────────────────────
create.mod Code::init(ptr.int ctx, ptr.int buf, int cap) {
    Ctx::set(ctx, 184, Cast::num(buf));
    Ctx::set(ctx, 192, cap);
    Ctx::set(ctx, 200, 0);
    create.int i = 0;
    while (i < 64) {
        __store_byte(buf, i, 0);
        i = i + 1;
    }
    Ctx::set(ctx, 200, 64);
}

create.mod Code::pos(ptr.int ctx).int {
    return Ctx::get(ctx, 200);
}

create.mod Code::seek(ptr.int ctx, int pos) {
    Ctx::set(ctx, 200, pos);
}

create.mod Code::u8(ptr.int ctx, int b) {
    create.int pos = Ctx::get(ctx, 200);
    create.ptr.int buf = Cast::toPtr(Ctx::get(ctx, 184));
    __store_byte(buf, pos, b);
    Ctx::set(ctx, 200, pos + 1);
}

create.mod Code::u16(ptr.int ctx, int v) {
    Code::u8(ctx, v % 256);
    Code::u8(ctx, (v / 256) % 256);
}

create.mod Code::u32(ptr.int ctx, int v) {
    Code::u8(ctx, v % 256);
    Code::u8(ctx, (v / 256) % 256);
    Code::u8(ctx, (v / 65536) % 256);
    Code::u8(ctx, (v / 16777216) % 256);
}

create.mod Code::u64(ptr.int ctx, int v) {
    create.int x = v;
    create.int i = 0;
    while (i < 8) {
        Code::u8(ctx, x % 256);
        x = x / 256;
        i = i + 1;
    }
}

create.mod Code::u32s(ptr.int ctx, int v) {
    create.int x = v;
    if (x < 0) {
        x = x + 4294967296;
    }
    Code::u32(ctx, x);
}

create.mod Code::patch8(ptr.int ctx, int pos, int v) {
    create.ptr.int buf = Cast::toPtr(Ctx::get(ctx, 184));
    __store_byte(buf, pos, v);
}

create.mod Code::patch32(ptr.int ctx, int pos, int v) {
    create.ptr.int buf = Cast::toPtr(Ctx::get(ctx, 184));
    __store_byte(buf, pos, v % 256);
    __store_byte(buf, pos + 1, (v / 256) % 256);
    __store_byte(buf, pos + 2, (v / 65536) % 256);
    __store_byte(buf, pos + 3, (v / 16777216) % 256);
}

create.mod Code::patch32s(ptr.int ctx, int pos, int v) {
    create.int x = v;
    if (x < 0) {
        x = x + 4294967296;
    }
    Code::patch32(ctx, pos, x);
}

create.mod Code::patchRel(ptr.int ctx, int dispPos, int target) {
    Code::patch32s(ctx, dispPos, target - (dispPos + 4));
}

create.mod Fix::init(ptr.int ctx, ptr.int dataFix, ptr.int iatFix) {
    Ctx::set(ctx, 328, Cast::num(dataFix));
    Ctx::set(ctx, 336, 0);
    Ctx::set(ctx, 344, Cast::num(iatFix));
    Ctx::set(ctx, 352, 0);
}

create.mod Fix::addData(ptr.int ctx, int pos, int off) {
    create.int n = Ctx::get(ctx, 336);
    if (n < 65536) {
        create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 328));
        Mem::store64(base, n * 16, pos);
        Mem::store64(base, n * 16 + 8, off);
        Ctx::set(ctx, 336, n + 1);
    }
}

create.mod Fix::addIat(ptr.int ctx, int pos, int off) {
    create.int n = Ctx::get(ctx, 352);
    if (n < 65536) {
        create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 344));
        Mem::store64(base, n * 16, pos);
        Mem::store64(base, n * 16 + 8, off);
        Ctx::set(ctx, 352, n + 1);
    }
}

create.mod Code::jmp(ptr.int ctx).int {
    Code::u8(ctx, 233);
    create.int pos = Ctx::get(ctx, 200);
    Code::u32(ctx, 0);
    return pos;
}

create.mod Code::jcc(ptr.int ctx, int cc).int {
    Code::u8(ctx, 15);
