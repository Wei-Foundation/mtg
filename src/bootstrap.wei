// ── Runtime stubs (emitted at the start of .text) ───────────────────────────
create.mod Rt::panicStub(ptr.int ctx, int msgOff).int {
    create.int pos = Code::pos(ctx);
    create.int p = Code::leaRip(ctx, 1);
    Fix::addData(ctx, p, 528);
    p = Code::leaRip(ctx, 2);
    Fix::addData(ctx, p, msgOff);
    Code::xorEax(ctx);
    Code::callIat(ctx, 0);
    Code::movEcxImm(ctx, 1);
    Code::callIat(ctx, 56);
    Code::int3(ctx);
    return pos;
}

create.mod Rt::alloc(ptr.int ctx) {
    Code::u8(ctx, 72);
    Code::u8(ctx, 133);
    Code::u8(ctx, 201);
    Code::jccTo(ctx, 14, Ctx::get(ctx, 472));
    Code::movRegReg(ctx, 0, 1);
    Code::addRaxImm8(ctx, 15);
    Code::andRaxImm8(ctx, 240);
    Code::movRegReg(ctx, 1, 0);
    create.int p = Code::movRipReg(ctx, 0);
    Fix::addData(ctx, p, 496);
    Code::movRegReg(ctx, 2, 0);
    Code::addRegReg(ctx, 2, 1);
    p = Code::movRipReg(ctx, 8);
    Fix::addData(ctx, p, 504);
    Code::cmpRdxR8(ctx);
    Code::jccTo(ctx, 7, Ctx::get(ctx, 472));
    p = Code::movRegRip(ctx, 2);
    Fix::addData(ctx, p, 496);
    Code::ret(ctx);
}

create.mod Rt::free(ptr.int ctx) {
    Code::ret(ctx);
}

create.mod Rt::readFile(ptr.int ctx) {
    Code::pushRbp(ctx);
    Code::movRbpRsp(ctx);
    Code::subRspImm(ctx, 96);
    Code::movSlotReg(ctx, 0, 1);
    Code::movSlotReg(ctx, 1, 2);
    Code::movSlotReg(ctx, 2, 8);
    Code::movRegSlot(ctx, 1, 0);
    create.int p = Code::leaRip(ctx, 2);
    Fix::addData(ctx, p, 320);
    Code::callIat(ctx, 8);
    Code::testRax(ctx);
    create.int jz0 = Code::jcc(ctx, 4);
    Code::movSlotReg(ctx, 3, 0);
    Code::movRegSlot(ctx, 1, 1);
    Code::movImm64(ctx, 2, 1);
    Code::movRegSlot(ctx, 8, 2);
    Code::movRegSlot(ctx, 9, 3);
    Code::callIat(ctx, 16);
    Code::movSlotReg(ctx, 4, 0);
    Code::movRegSlot(ctx, 1, 3);
    Code::callIat(ctx, 32);
    Code::movRegSlot(ctx, 0, 4);
    Code::movRspRbp(ctx);
    Code::popRbp(ctx);
    Code::ret(ctx);
    Code::patchRel(ctx, jz0, Code::pos(ctx));
    Code::xorEax(ctx);
    Code::movRspRbp(ctx);
    Code::popRbp(ctx);
    Code::ret(ctx);
}

create.mod Rt::writeFile(ptr.int ctx) {
    Code::pushRbp(ctx);
    Code::movRbpRsp(ctx);
    Code::subRspImm(ctx, 96);
    Code::movSlotReg(ctx, 0, 1);
    Code::movSlotReg(ctx, 1, 2);
    Code::movSlotReg(ctx, 2, 8);
    Code::movRegSlot(ctx, 1, 0);
    create.int p = Code::leaRip(ctx, 2);
    Fix::addData(ctx, p, 323);
    Code::callIat(ctx, 8);
    Code::testRax(ctx);
    create.int jz0 = Code::jcc(ctx, 4);
    Code::movSlotReg(ctx, 3, 0);
    Code::movRegSlot(ctx, 1, 1);
    Code::movImm64(ctx, 2, 1);
    Code::movRegSlot(ctx, 8, 2);
    Code::movRegSlot(ctx, 9, 3);
    Code::callIat(ctx, 24);
    Code::movSlotReg(ctx, 4, 0);
    Code::movRegSlot(ctx, 1, 3);
    Code::callIat(ctx, 32);
    Code::movRegSlot(ctx, 0, 4);
    Code::movRspRbp(ctx);
    Code::popRbp(ctx);
    Code::ret(ctx);
    Code::patchRel(ctx, jz0, Code::pos(ctx));
    Code::xorEax(ctx);
    Code::movRspRbp(ctx);
    Code::popRbp(ctx);
    Code::ret(ctx);
}

create.mod Rt::init(ptr.int ctx) {
    Ctx::set(ctx, 456, Rt::panicStub(ctx, Ctx::get(ctx, 536)));
    Ctx::set(ctx, 464, Rt::panicStub(ctx, Ctx::get(ctx, 544)));
    Ctx::set(ctx, 472, Rt::panicStub(ctx, Ctx::get(ctx, 552)));
    Ctx::set(ctx, 480, Code::pos(ctx));
    Rt::alloc(ctx);
    Ctx::set(ctx, 488, Code::pos(ctx));
    Rt::free(ctx);
    Ctx::set(ctx, 496, Code::pos(ctx));
    Rt::readFile(ctx);
    Ctx::set(ctx, 504, Code::pos(ctx));
    Rt::writeFile(ctx);
}

// ── PE32+ writer ────────────────────────────────────────────────────────────
create.mod Num::alignUp(int v, int a).int {
    create.int r = v % a;
    if (r == 0) {
        return v;
    }
    return v + (a - r);
}

create.mod Pe::zero(ptr.int buf, int start, int stop) {
    create.int i = start;
    while (i < stop) {
        __store_byte(buf, i, 0);
        i = i + 1;
    }
}

create.mod Pe::u16(ptr.int buf, int off, int v) {
    __store_byte(buf, off, v % 256);
    __store_byte(buf, off + 1, (v / 256) % 256);
}

create.mod Pe::u32(ptr.int buf, int off, int v) {
    __store_byte(buf, off, v % 256);
    __store_byte(buf, off + 1, (v / 256) % 256);
    __store_byte(buf, off + 2, (v / 65536) % 256);
    __store_byte(buf, off + 3, (v / 16777216) % 256);
}

create.mod Pe::u64(ptr.int buf, int off, int v) {
    create.int x = v;
    create.int i = 0;
    while (i < 8) {
        __store_byte(buf, off + i, x % 256);
        x = x / 256;
        i = i + 1;
    }
}

create.mod Pe::putStr(ptr.int buf, int off, char s).int {
    create.int i = 0;
    create.int c = __byte_at(s, 0);
    while (c != 0) {
        __store_byte(buf, off + i, c);
        i = i + 1;
        c = __byte_at(s, i);
    }
    __store_byte(buf, off + i, 0);
    return off + i + 1;
}

create.mod Pe::fillImports(ptr.int ctx, ptr.int data, int dataRva) {
    Pe::zero(data, 0, 512);
    Pe::putStr(data, 146, "printf");
    Pe::putStr(data, 156, "fopen");
    Pe::putStr(data, 164, "fread");
    Pe::putStr(data, 172, "fwrite");
    Pe::putStr(data, 182, "fclose");
    Pe::putStr(data, 192, "GetCommandLineA");
    Pe::putStr(data, 210, "ExitProcess");
    Pe::putStr(data, 222, "msvcrt.dll");
    Pe::putStr(data, 233, "kernel32.dll");
    Pe::putStr(data, 320, "rb");
    Pe::putStr(data, 323, "wb");
    Pe::u64(data, 0, dataRva + 144);
    Pe::u64(data, 8, dataRva + 154);
    Pe::u64(data, 16, dataRva + 162);
    Pe::u64(data, 24, dataRva + 170);
    Pe::u64(data, 32, dataRva + 180);
    Pe::u64(data, 40, 0);
    Pe::u64(data, 48, dataRva + 190);
    Pe::u64(data, 56, dataRva + 208);
    Pe::u64(data, 64, 0);
    Pe::u64(data, 72, dataRva + 144);
    Pe::u64(data, 80, dataRva + 154);
    Pe::u64(data, 88, dataRva + 162);
    Pe::u64(data, 96, dataRva + 170);
    Pe::u64(data, 104, dataRva + 180);
    Pe::u64(data, 112, 0);
    Pe::u64(data, 120, dataRva + 190);
    Pe::u64(data, 128, dataRva + 208);
    Pe::u64(data, 136, 0);
    Pe::u32(data, 256, dataRva + 72);
    Pe::u32(data, 260, 0);
    Pe::u32(data, 264, 0);
    Pe::u32(data, 268, dataRva + 222);
    Pe::u32(data, 272, dataRva);
    Pe::u32(data, 276, dataRva + 120);
    Pe::u32(data, 280, 0);
    Pe::u32(data, 284, 0);
    Pe::u32(data, 288, dataRva + 233);
    Pe::u32(data, 292, dataRva + 48);
}

create.mod Pe::patchFixes(ptr.int ctx, int dataRva) {
    create.int n = Ctx::get(ctx, 336);
    create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 328));
    create.int i = 0;
    create.int pos = 0;
    create.int off = 0;
    while (i < n) {
        pos = Mem::load64(base, i * 16);
        off = Mem::load64(base, i * 16 + 8);
        Code::patch32s(ctx, pos, dataRva + off - (4096 + pos + 4));
        i = i + 1;
    }
    n = Ctx::get(ctx, 352);
    base = Cast::toPtr(Ctx::get(ctx, 344));
    i = 0;
    while (i < n) {
        pos = Mem::load64(base, i * 16);
        off = Mem::load64(base, i * 16 + 8);
        Code::patch32s(ctx, pos, dataRva + off - (4096 + pos + 4));
        i = i + 1;
    }
}

create.mod Pe::emitEntry(ptr.int ctx, int dataRva, int heapOff, int mainPos) {
    create.int save = Ctx::get(ctx, 200);
    Code::seek(ctx, 0);
    Code::pushRbp(ctx);
    Code::movRbpRsp(ctx);
    Code::subRspImm(ctx, 32);
    create.int p = Code::leaRip(ctx, 0);
    Code::patch32s(ctx, p, dataRva + heapOff - (4096 + p + 4));
    p = Code::movRegRip(ctx, 0);
    Code::patch32s(ctx, p, dataRva + 496 - (4096 + p + 4));
    p = Code::leaRip(ctx, 0);
    Code::patch32s(ctx, p, dataRva + heapOff + 33554432 - (4096 + p + 4));
    p = Code::movRegRip(ctx, 0);
    Code::patch32s(ctx, p, dataRva + 504 - (4096 + p + 4));
    p = Code::call(ctx);
    Code::patch32s(ctx, p, mainPos - (p + 4));
    Code::xorEcx(ctx);
    Code::u8(ctx, 255);
    Code::u8(ctx, 21);
    p = Ctx::get(ctx, 200);
    Code::u32(ctx, 0);
    Code::patch32s(ctx, p, dataRva + 56 - (4096 + p + 4));
    Code::int3(ctx);
    Code::seek(ctx, save);
}

create.mod Pe::copyCode(ptr.int ctx, ptr.int out, int dstOff) {
    create.int n = Ctx::get(ctx, 200);
    create.ptr.int src = Cast::toPtr(Ctx::get(ctx, 184));
    create.int i = 0;
    while (i < n) {
        __store_byte(out, dstOff + i, __byte_at(src, i));
        i = i + 1;
    }
}

create.mod Pe::copyData(ptr.int ctx, ptr.int out, int dstOff, int n) {
    create.ptr.int src = Cast::toPtr(Ctx::get(ctx, 208));
    create.int i = 0;
    while (i < n) {
        __store_byte(out, dstOff + i, __byte_at(src, i));
        i = i + 1;
    }
}

create.mod Pe::headers(ptr.int ctx, ptr.int out, int dataRva, int heapOff) {
    create.int codeSize = Ctx::get(ctx, 200);
    create.int textRaw = Num::alignUp(codeSize, 512);
    create.int dataRaw = Num::alignUp(heapOff, 512);
    create.int imageSize = Num::alignUp(dataRva + heapOff + 33554432, 4096);
    Pe::u16(out, 0, 23117);
    Pe::u32(out, 60, 64);
    Pe::u32(out, 64, 17744);
    Pe::u16(out, 68, 34404);
    Pe::u16(out, 70, 2);
    Pe::u32(out, 72, 0);
    Pe::u32(out, 76, 0);
    Pe::u32(out, 80, 0);
    Pe::u16(out, 84, 240);
    Pe::u16(out, 86, 34);
    create.int opt = 88;
    Pe::u16(out, opt, 523);
    Pe::u32(out, opt + 4, textRaw);
    Pe::u32(out, opt + 8, dataRaw);
    Pe::u32(out, opt + 12, 0);
    Pe::u32(out, opt + 16, 4096);
    Pe::u32(out, opt + 20, 4096);
    Pe::u64(out, opt + 24, 5368709120);
    Pe::u32(out, opt + 32, 4096);
    Pe::u32(out, opt + 36, 512);
    Pe::u16(out, opt + 40, 6);
    Pe::u16(out, opt + 42, 0);
    Pe::u16(out, opt + 44, 0);
    Pe::u16(out, opt + 46, 0);
    Pe::u16(out, opt + 48, 6);
    Pe::u16(out, opt + 50, 0);
    Pe::u32(out, opt + 52, 0);
    Pe::u32(out, opt + 56, imageSize);
    Pe::u32(out, opt + 60, 512);
    Pe::u32(out, opt + 64, 0);
    Pe::u16(out, opt + 68, 3);
    Pe::u16(out, opt + 70, 256);
    Pe::u64(out, opt + 72, 16777216);
    Pe::u64(out, opt + 80, 1048576);
    Pe::u64(out, opt + 88, 1048576);
    Pe::u64(out, opt + 96, 4096);
    Pe::u32(out, opt + 104, 0);
    Pe::u32(out, opt + 108, 16);
    Pe::u32(out, opt + 120, dataRva + 256);
    Pe::u32(out, opt + 124, 60);
    Pe::u32(out, opt + 208, dataRva);
    Pe::u32(out, opt + 212, 72);
    create.int text = 328;
    __store_byte(out, text, 46);
    __store_byte(out, text + 1, 116);
    __store_byte(out, text + 2, 101);
    __store_byte(out, text + 3, 120);
    __store_byte(out, text + 4, 116);
    Pe::u32(out, text + 8, codeSize);
    Pe::u32(out, text + 12, 4096);
    Pe::u32(out, text + 16, textRaw);
    Pe::u32(out, text + 20, 512);
    Pe::u32(out, text + 36, 1610612768);
    create.int data = 368;
    __store_byte(out, data, 46);
    __store_byte(out, data + 1, 100);
    __store_byte(out, data + 2, 97);
    __store_byte(out, data + 3, 116);
    __store_byte(out, data + 4, 97);
    Pe::u32(out, data + 8, heapOff + 33554432);
    Pe::u32(out, data + 12, dataRva);
    Pe::u32(out, data + 16, dataRaw);
    Pe::u32(out, data + 20, 512 + textRaw);
    Pe::u32(out, data + 36, 3221225536);
}

create.mod Pe::build(ptr.int ctx, ptr.int out, int cap, int mainPos).int {
    create.int codeSize = Ctx::get(ctx, 200);
    create.int heapOff = Num::alignUp(Ctx::get(ctx, 224), 16);
    create.int textRaw = Num::alignUp(codeSize, 512);
    create.int dataRva = Num::alignUp(4096 + codeSize, 4096);
    create.int dataRaw = Num::alignUp(heapOff, 512);
    create.int total = 512 + textRaw + dataRaw;
    if (total > cap) {
        return 0;
    }
    create.ptr.int data = Cast::toPtr(Ctx::get(ctx, 208));
    Pe::zero(out, 0, total);
    Pe::fillImports(ctx, data, dataRva);
    Pe::patchFixes(ctx, dataRva);
    Pe::emitEntry(ctx, dataRva, heapOff, mainPos);
    Pe::headers(ctx, out, dataRva, heapOff);
    Pe::copyCode(ctx, out, 512);
    Pe::copyData(ctx, out, 512 + textRaw, heapOff);
    create.char path = Cast::text(Ctx::get(ctx, 432));
    return __write_file(path, out, total);
}

create.mod Str::appendNum(char dst, int used, int max, int v).int {
    create.int digs[24];
    create.int n = 0;
    create.int x = v;
    create.int neg = 0;
    if (x < 0) {
        neg = 1;
        x = 0 - x;
    }
    if (x == 0) {
        digs[0] = 48;
        n = 1;
    }
    while (x > 0) {
        digs[n] = 48 + x % 10;
        n = n + 1;
        x = x / 10;
    }
    if (neg == 1) {
        if (used < max - 1) {
            __store_byte(dst, used, 45);
            used = used + 1;
        }
    }
    while (n > 0) {
        n = n - 1;
        if (used < max - 1) {
            __store_byte(dst, used, digs[n]);
            used = used + 1;
        }
    }
    __store_byte(dst, used, 0);
    return used;
}

create.mod Err::text(int code).char {
    if (code == 1) { return "expected 'create'"; }
    if (code == 2) { return "expected '.'"; }
    if (code == 3) { return "expected 'mod'"; }
    if (code == 4) { return "expected identifier"; }
    if (code == 5) { return "expected '::'"; }
    if (code == 6) { return "expected '('"; }
    if (code == 7) { return "expected ')'"; }
    if (code == 8) { return "expected '{'"; }
    if (code == 9) { return "expected '}'"; }
    if (code == 10) { return "expected ';'"; }
    if (code == 11) { return "expected type"; }
    if (code == 12) { return "expected expression"; }
    if (code == 13) { return "unknown variable"; }
    if (code == 14) { return "unknown function (must be defined before use)"; }
    if (code == 15) { return "too many parameters"; }
    if (code == 16) { return "too many arguments"; }
    if (code == 17) { return "function table full"; }
    if (code == 18) { return "local table full"; }
    if (code == 19) { return "duplicate function"; }
    if (code == 20) { return "duplicate local"; }
    if (code == 21) { return "array length must be 1..65536"; }
    if (code == 22) { return "too many frame slots"; }
    if (code == 23) { return "array initializer too long"; }
    if (code == 24) { return "expected '='"; }
    if (code == 25) { return "invalid assignment target"; }
    if (code == 26) { return "type mismatch"; }
    if (code == 27) { return "unsupported builtin"; }
    if (code == 28) { return "missing Main::main"; }
    if (code == 29) { return "nesting too deep"; }
    if (code == 30) { return "unsupported operator"; }
    if (code == 31) { return "expected return type"; }
    if (code == 32) { return "expected array subscript"; }
    if (code == 33) { return "expected builtin call"; }
    if (code == 36) { return "expected integer literal"; }
    if (code == 37) { return "expression temp slots exhausted"; }
    return "syntax error";
}

create.mod Err::lexText(int code).char {
    if (code == 1) { return "unterminated string literal"; }
    if (code == 2) { return "unknown character"; }
    if (code == 3) { return "integer literal overflow"; }
    if (code == 4) { return "identifier too long"; }
    if (code == 5) { return "string literal too long"; }
    if (code == 6) { return "stray ':'"; }
    if (code == 7) { return "stray '&'"; }
    if (code == 8) { return "stray '|'"; }
    return "lexer error";
}

create.mod Err::report(ptr.int ctx, char file) {
    create.ptr.int raw = Mem::alloc(2048);
    create.char msg = Cast::text(raw);
    create.int n = Str::append(msg, 0, 2048, file);
    n = Str::append(msg, n, 2048, ":");
    n = Str::appendNum(msg, n, 2048, Ctx::get(ctx, 48));
    n = Str::append(msg, n, 2048, ":");
    n = Str::appendNum(msg, n, 2048, Ctx::get(ctx, 56));
    n = Str::append(msg, n, 2048, ": ");
    if (Ctx::get(ctx, 40) == 1) {
        n = Str::append(msg, n, 2048, Err::lexText(Ctx::get(ctx, 64)));
    } else {
        n = Str::append(msg, n, 2048, Err::text(Ctx::get(ctx, 64)));
    }
    do.emit::msg;
    Mem::free(raw);
}

create.mod Msg::fileErr(char file, char text) {
    create.ptr.int raw = Mem::alloc(2048);
    create.char msg = Cast::text(raw);
    create.int n = Str::append(msg, 0, 2048, file);
    n = Str::append(msg, n, 2048, ":?:?: ");
    Str::append(msg, n, 2048, text);
    do.emit::msg;
    Mem::free(raw);
}

create.mod Msg::done(char out) {
    create.ptr.int raw = Mem::alloc(8192);
    create.char msg = Cast::text(raw);
    create.int n = Str::append(msg, 0, 8192, "[done] ");
    n = Str::append(msg, n, 8192, out);
    Str::append(msg, n, 8192, " (win64)");
    do.emit::msg;
    Mem::free(raw);
}

create.mod Parse::fail(ptr.int ctx, int code).int {
    if (Ctx::get(ctx, 40) == 0) {
        Ctx::set(ctx, 40, 2);
        Ctx::set(ctx, 48, Ctx::get(ctx, 112));
        Ctx::set(ctx, 56, Ctx::get(ctx, 120));
        Ctx::set(ctx, 64, code);
    }
    return 0;
}

create.mod Parse::expect(ptr.int ctx, int kind, int code).int {
    if (Ctx::get(ctx, 72) != kind) {
        return Parse::fail(ctx, code);
    }
    Lex::next(ctx);
    return 1;
}

create.mod Src::eqRange(ptr.int ctx, int a, int b, int len).int {
    create.int i = 0;
    while (i < len) {
        if (Src::byte(ctx, a + i) != Src::byte(ctx, b + i)) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

create.mod Ident::eqCur(ptr.int ctx, char lit).int {
    return Src::eq(ctx, Ctx::get(ctx, 80), Ctx::get(ctx, 88), lit);
}

create.mod Ident::eqTok(ptr.int ctx, int base, char lit).int {
    return Src::eq(ctx, Ctx::get(ctx, base), Ctx::get(ctx, base + 8), lit);
}

create.mod Ident::saveTo(ptr.int ctx, int base) {
    Ctx::set(ctx, base, Ctx::get(ctx, 80));
    Ctx::set(ctx, base + 8, Ctx::get(ctx, 88));
}

create.mod Ty::compat(int a, int b).int {
    if (a == b) {
        return 1;
    }
    if (a == 3 || b == 3) {
        return 1;
    }
    return 0;
}

// ── Function table (96-byte entries) ────────────────────────────────────────
//   0 modOff, 8 modLen, 16 nameOff, 24 nameLen, 32 codePos,
//   40 paramCount, 48..72 paramTypes, 80 retType, 88 defined
create.mod Fn::get(ptr.int ctx, int i, int field).int {
    create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 232));
    return Mem::load64(base, i * 96 + field);
}

create.mod Fn::set(ptr.int ctx, int i, int field, int value) {
    create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 232));
    Mem::store64(base, i * 96 + field, value);
}

create.mod Fn::add(ptr.int ctx, int modOff, int nameOff, int codePos).int {
    create.int n = Ctx::get(ctx, 240);
    if (n >= 512) {
        Parse::fail(ctx, 17);
        return 0 - 1;
    }
    create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 232));
    Mem::store64(base, n * 96, modOff);
    Mem::store64(base, n * 96 + 8, 0);
    Mem::store64(base, n * 96 + 16, nameOff);
    Mem::store64(base, n * 96 + 24, 0);
    Mem::store64(base, n * 96 + 32, codePos);
    Mem::store64(base, n * 96 + 40, 0);
    Mem::store64(base, n * 96 + 48, 0);
    Mem::store64(base, n * 96 + 56, 0);
    Mem::store64(base, n * 96 + 64, 0);
    Mem::store64(base, n * 96 + 72, 0);
    Mem::store64(base, n * 96 + 80, 4);
    Mem::store64(base, n * 96 + 88, 0);
    Ctx::set(ctx, 240, n + 1);
    return n;
}

create.mod Fn::findSaved(ptr.int ctx).int {
    create.int n = Ctx::get(ctx, 240);
    create.int i = 0;
    while (i < n) {
        if (Fn::get(ctx, i, 8) == Ctx::get(ctx, 568) && Fn::get(ctx, i, 24) == Ctx::get(ctx, 584)) {
            if (Src::eqRange(ctx, Fn::get(ctx, i, 0), Ctx::get(ctx, 560), Ctx::get(ctx, 568)) == 1) {
                if (Src::eqRange(ctx, Fn::get(ctx, i, 16), Ctx::get(ctx, 576), Ctx::get(ctx, 584)) == 1) {
                    return i;
                }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

// ── Local table (48-byte entries) ───────────────────────────────────────────
//   0 nameOff, 8 nameLen, 16 slot, 24 arrayLen, 32 type
create.mod Loc::get(ptr.int ctx, int i, int field).int {
    create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 248));
    return Mem::load64(base, i * 48 + field);
}

create.mod Loc::set(ptr.int ctx, int i, int field, int value) {
    create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 248));
    Mem::store64(base, i * 48 + field, value);
}

create.mod Loc::findCur(ptr.int ctx).int {
    create.int n = Ctx::get(ctx, 256);
    create.int i = n - 1;
    create.int len = Ctx::get(ctx, 88);
    while (i >= 0) {
        if (Loc::get(ctx, i, 8) == len) {
            if (Src::eqRange(ctx, Loc::get(ctx, i, 0), Ctx::get(ctx, 80), len) == 1) {
                return i;
            }
        }
        i = i - 1;
    }
    return 0 - 1;
}

create.mod Loc::findTok(ptr.int ctx, int base).int {
    create.int n = Ctx::get(ctx, 256);
    create.int i = n - 1;
    create.int len = Ctx::get(ctx, base + 8);
    while (i >= 0) {
        if (Loc::get(ctx, i, 8) == len) {
            if (Src::eqRange(ctx, Loc::get(ctx, i, 0), Ctx::get(ctx, base), len) == 1) {
                return i;
            }
        }
        i = i - 1;
    }
    return 0 - 1;
}

create.mod Loc::addAt(ptr.int ctx, int ty, int arrLen, int nameBase).int {
    create.int n = Ctx::get(ctx, 256);
    if (n >= 1024) {
        Parse::fail(ctx, 18);
        return 0 - 1;
    }
    if (Loc::findTok(ctx, nameBase) >= 0) {
        Parse::fail(ctx, 20);
        return 0 - 1;
    }
    create.int width = 1;
    if (arrLen > 0) {
        width = arrLen;
    }
    if (Ctx::get(ctx, 280) + width > 131072) {
        Parse::fail(ctx, 22);
        return 0 - 1;
    }
    create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 248));
    Mem::store64(base, n * 48, Ctx::get(ctx, nameBase));
    Mem::store64(base, n * 48 + 8, Ctx::get(ctx, nameBase + 8));
    Mem::store64(base, n * 48 + 16, 68 + Ctx::get(ctx, 280));
    Mem::store64(base, n * 48 + 24, arrLen);
    Mem::store64(base, n * 48 + 32, ty);
    Ctx::set(ctx, 280, Ctx::get(ctx, 280) + width);
    Ctx::set(ctx, 256, n + 1);
    return n;
}

create.mod Loc::addParamAt(ptr.int ctx, int ty, int index, int nameBase).int {
    create.int n = Ctx::get(ctx, 256);
    if (n >= 1024) {
        Parse::fail(ctx, 18);
        return 0 - 1;
    }
    if (Loc::findTok(ctx, nameBase) >= 0) {
        Parse::fail(ctx, 20);
        return 0 - 1;
    }
    create.ptr.int base = Cast::toPtr(Ctx::get(ctx, 248));
    Mem::store64(base, n * 48, Ctx::get(ctx, nameBase));
    Mem::store64(base, n * 48 + 8, Ctx::get(ctx, nameBase + 8));
    Mem::store64(base, n * 48 + 16, 64 + index);
    Mem::store64(base, n * 48 + 24, 0);
    Mem::store64(base, n * 48 + 32, ty);
    Ctx::set(ctx, 256, n + 1);
    return n;
}

// ── Block stack (64-byte frames) ────────────────────────────────────────────
//   0 kind, 8 savedLocalCount, 16 jump1, 24 jump2, 32 loopStart,
//   40 aux1, 48 aux2, 56 aux3
create.mod Blk::get(ptr.int ctx, int depth, int field).int {
    return Ctx::get(ctx, 1024 + depth * 64 + field);
}

create.mod Blk::set(ptr.int ctx, int depth, int field, int value) {
    Ctx::set(ctx, 1024 + depth * 64 + field, value);
}

create.mod Parse::push(ptr.int ctx, int kind, int jump1, int loopStart).int {
    create.int depth = Ctx::get(ctx, 520);
    if (depth >= 64) {
        return Parse::fail(ctx, 29);
    }
    Blk::set(ctx, depth, 0, kind);
    Blk::set(ctx, depth, 8, Ctx::get(ctx, 256));
    Blk::set(ctx, depth, 16, jump1);
    Blk::set(ctx, depth, 24, 0);
    Blk::set(ctx, depth, 32, loopStart);
    Blk::set(ctx, depth, 40, 0);
    Blk::set(ctx, depth, 48, 0);
    Blk::set(ctx, depth, 56, Ctx::get(ctx, 280));
    Ctx::set(ctx, 520, depth + 1);
    return 1;
}

create.mod Parse::callEmit(ptr.int ctx, int argc, int base).int {
    create.int idx = Fn::findSaved(ctx);
    if (idx < 0) {
        return Parse::fail(ctx, 14);
    }
    if (Fn::get(ctx, idx, 40) != argc) {
        return Parse::fail(ctx, 16);
    }
    if (argc > 0) {
        Code::movRegSlot(ctx, 1, base);
    }
    if (argc > 1) {
        Code::movRegSlot(ctx, 2, base + 1);
    }
    if (argc > 2) {
        Code::movRegSlot(ctx, 8, base + 2);
    }
    if (argc > 3) {
        Code::movRegSlot(ctx, 9, base + 3);
    }
    create.int p = Code::call(ctx);
    Code::patchRel(ctx, p, Fn::get(ctx, idx, 32));
    Ctx::set(ctx, 512, Fn::get(ctx, idx, 80));
    return 1;
}

create.mod Parse::builtinEmit(ptr.int ctx, int argc, int base).int {
    if (Ident::eqTok(ctx, 560, "__command_line") == 1) {
        if (argc != 0) {
            return Parse::fail(ctx, 16);
        }
        Code::callIat(ctx, 48);
        Ctx::set(ctx, 512, 3);
        return 1;
    }
    if (Ident::eqTok(ctx, 560, "__exit") == 1) {
        if (argc != 1) {
            return Parse::fail(ctx, 16);
        }
        Code::movRegSlot(ctx, 1, base);
        Code::callIat(ctx, 56);
        Code::int3(ctx);
        Ctx::set(ctx, 512, 4);
        return 1;
    }
    if (Ident::eqTok(ctx, 560, "__byte_at") == 1) {
        if (argc != 2) {
            return Parse::fail(ctx, 16);
        }
        Code::movRegSlot(ctx, 1, base);
        Code::movRegSlot(ctx, 2, base + 1);
        Code::loadByte(ctx);
        Ctx::set(ctx, 512, 0);
        return 1;
    }
    if (Ident::eqTok(ctx, 560, "__store_byte") == 1) {
        if (argc != 3) {
            return Parse::fail(ctx, 16);
        }
        Code::movRegSlot(ctx, 1, base);
        Code::movRegSlot(ctx, 2, base + 1);
        Code::movRegSlot(ctx, 8, base + 2);
        Code::storeByte(ctx);
        Ctx::set(ctx, 512, 4);
        return 1;
    }
    if (Ident::eqTok(ctx, 560, "__rt_alloc") == 1) {
        if (argc != 1) {
            return Parse::fail(ctx, 16);
        }
        Code::movRegSlot(ctx, 1, base);
        create.int p = Code::call(ctx);
        Code::patchRel(ctx, p, Ctx::get(ctx, 480));
        Ctx::set(ctx, 512, 3);
        return 1;
    }
    if (Ident::eqTok(ctx, 560, "__rt_free") == 1) {
        if (argc != 1) {
            return Parse::fail(ctx, 16);
        }
        Code::movRegSlot(ctx, 1, base);
        create.int p = Code::call(ctx);
        Code::patchRel(ctx, p, Ctx::get(ctx, 488));
        Ctx::set(ctx, 512, 4);
        return 1;
    }
    if (Ident::eqTok(ctx, 560, "__read_file") == 1) {
        if (argc != 3) {
            return Parse::fail(ctx, 16);
        }
        Code::movRegSlot(ctx, 1, base);
        Code::movRegSlot(ctx, 2, base + 1);
        Code::movRegSlot(ctx, 8, base + 2);
        create.int p = Code::call(ctx);
        Code::patchRel(ctx, p, Ctx::get(ctx, 496));
        Ctx::set(ctx, 512, 0);
        return 1;
    }
    if (Ident::eqTok(ctx, 560, "__write_file") == 1) {
        if (argc != 3) {
            return Parse::fail(ctx, 16);
        }
        Code::movRegSlot(ctx, 1, base);
        Code::movRegSlot(ctx, 2, base + 1);
        Code::movRegSlot(ctx, 8, base + 2);
        create.int p = Code::call(ctx);
        Code::patchRel(ctx, p, Ctx::get(ctx, 504));
        Ctx::set(ctx, 512, 0);
        return 1;
    }
    return Parse::fail(ctx, 27);
}

create.mod Code::testRcx(ptr.int ctx) {
    Code::u8(ctx, 72);
    Code::u8(ctx, 133);
    Code::u8(ctx, 201);
}

create.mod Ident::isBuiltinTok(ptr.int ctx, int base).int {
    if (Ident::eqTok(ctx, base, "__command_line") == 1) { return 1; }
    if (Ident::eqTok(ctx, base, "__exit") == 1) { return 1; }
    if (Ident::eqTok(ctx, base, "__byte_at") == 1) { return 1; }
    if (Ident::eqTok(ctx, base, "__store_byte") == 1) { return 1; }
    if (Ident::eqTok(ctx, base, "__rt_alloc") == 1) { return 1; }
    if (Ident::eqTok(ctx, base, "__rt_free") == 1) { return 1; }
    if (Ident::eqTok(ctx, base, "__read_file") == 1) { return 1; }
    if (Ident::eqTok(ctx, base, "__write_file") == 1) { return 1; }
    return 0;
}

create.mod Expr::prec(int k).int {
    if (k == 54) { return 1; }
    if (k == 53) { return 2; }
    if (k == 41 || k == 42) { return 3; }
    if (k >= 43 && k <= 46) { return 4; }
    if (k == 47 || k == 48) { return 5; }
    if (k == 49 || k == 50 || k == 51) { return 6; }
    return 0;
}

create.mod Expr::parse(ptr.int ctx, int minPrec).int {
    create.int k = Ctx::get(ctx, 72);
    if (k == 48) {
        Lex::next(ctx);
        if (Expr::parse(ctx, 7) == 0) { return 0; }
        Code::negRax(ctx);
        Ctx::set(ctx, 512, 0);
    } else {
        if (k == 52) {
            Lex::next(ctx);
            if (Expr::parse(ctx, 7) == 0) { return 0; }
            Code::testRax(ctx);
            Code::setccAl(ctx, 4);
            Code::movzxEaxAl(ctx);
            Ctx::set(ctx, 512, 0);
        } else {
            if (k == 3) {
                Code::movImm64(ctx, 0, Ctx::get(ctx, 96));
                Ctx::set(ctx, 512, 0);
                Lex::next(ctx);
            } else {
                if (k == 4) {
                    create.int p = Code::leaRip(ctx, 0);
                    Fix::addData(ctx, p, Ctx::get(ctx, 104));
                    Ctx::set(ctx, 512, 1);
                    Lex::next(ctx);
                } else {
                    if (k == 20) {
                        Code::movImm64(ctx, 0, 1);
                        Ctx::set(ctx, 512, 0);
                        Lex::next(ctx);
                    } else {
                        if (k == 21) {
                            Code::movImm64(ctx, 0, 0);
                            Ctx::set(ctx, 512, 0);
                            Lex::next(ctx);
                        } else {
                            if (k == 59) {
                                Code::movImm64(ctx, 0, 0);
                                Ctx::set(ctx, 512, 3);
                                Lex::next(ctx);
                            } else {
                            if (k == 60) {
                                Lex::next(ctx);
                                if (Parse::expect(ctx, 34, 6) == 0) { return 0; }
                                if (Parse::valueType(ctx) < 0) { return 0; }
                                if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
                                Code::movImm64(ctx, 0, 8);
                                Ctx::set(ctx, 512, 0);
                            } else {
                            if (k == 61) {
                                Lex::next(ctx);
                                if (Parse::expect(ctx, 34, 6) == 0) { return 0; }
                                if (Parse::valueType(ctx) < 0) { return 0; }
                                if (Parse::expect(ctx, 38, 8) == 0) { return 0; }
                                if (Expr::parse(ctx, 1) == 0) { return 0; }
                                if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
                            } else {
                            if (k == 62) {
                                Lex::next(ctx);
                                if (Parse::valueType(ctx) < 0) { return 0; }
                                Code::movImm64(ctx, 1, 8);
                                create.int np = Code::call(ctx);
                                Code::patchRel(ctx, np, Ctx::get(ctx, 480));
                                Code::u8(ctx, 72);
                                Code::u8(ctx, 199);
                                Code::u8(ctx, 0);
                                Code::u32(ctx, 0);
                                Ctx::set(ctx, 512, 3);
                            } else {
                            if (k == 63) {
                                Lex::next(ctx);
                                if (Expr::parse(ctx, 1) == 0) { return 0; }
                                Code::u8(ctx, 72);
                                Code::u8(ctx, 137);
                                Code::u8(ctx, 193);
                                create.int dp = Code::call(ctx);
                                Code::patchRel(ctx, dp, Ctx::get(ctx, 488));
                                Ctx::set(ctx, 512, 4);
                            } else {
                            if (k == 34) {
                                Lex::next(ctx);
                                if (Expr::parse(ctx, 1) == 0) { return 0; }
                                if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
                            } else {
                                if (k == 2) {
                                    create.int idx = Loc::findCur(ctx);
                                    if (idx >= 0) {
                                        create.int slot = Loc::get(ctx, idx, 16);
                                        create.int arrLen = Loc::get(ctx, idx, 24);
                                        create.int ty = Loc::get(ctx, idx, 32);
                                        if (arrLen > 0) {
                                            Code::leaSlotOff(ctx, 0, slot, (arrLen - 1) * 8);
                                            Ctx::set(ctx, 512, 2);
                                        } else {
                                            Code::movRegSlot(ctx, 0, slot);
                                            Ctx::set(ctx, 512, ty);
                                        }
                                        Lex::next(ctx);
                                        if (arrLen == 0 && Ctx::get(ctx, 72) == 55) {
                                            Code::addRaxImm8(ctx, 1);
                                            Code::movSlotReg(ctx, slot, 0);
                                            Lex::next(ctx);
                                        } else {
                                            if (arrLen == 0 && Ctx::get(ctx, 72) == 56) {
                                                Code::addRaxImm8(ctx, 255);
                                                Code::movSlotReg(ctx, slot, 0);
                                                Lex::next(ctx);
                                            }
                                        }
                                        if (Ctx::get(ctx, 72) == 36) {
                                            if (arrLen <= 0) { return Parse::fail(ctx, 32); }
                                            Lex::next(ctx);
                                            if (Expr::parse(ctx, 1) == 0) { return 0; }
                                            if (Parse::expect(ctx, 37, 7) == 0) { return 0; }
                                            Code::cmpRaxImm(ctx, arrLen);
                                            Code::jccTo(ctx, 3, Ctx::get(ctx, 464));
                                            Code::leaSlotOff(ctx, 1, slot, (arrLen - 1) * 8);
                                            Code::loadElem(ctx);
                                            Ctx::set(ctx, 512, 0);
                                        }
                                    } else {
                                        create.int mode = 1;
                                        Ident::saveTo(ctx, 560);
                                        Lex::next(ctx);
                                        if (Ctx::get(ctx, 72) == 30) {
                                            Lex::next(ctx);
                                            if (Ctx::get(ctx, 72) != 2) { return Parse::fail(ctx, 4); }
                                            Ident::saveTo(ctx, 576);
                                            Lex::next(ctx);
                                        } else {
                                            if (Ctx::get(ctx, 72) == 34 && Ident::isBuiltinTok(ctx, 560) == 1) {
                                                mode = 2;
                                            } else {
                                                return Parse::fail(ctx, 13);
                                            }
                                        }
                                        if (Ctx::get(ctx, 72) != 34) { return Parse::fail(ctx, 6); }
                                        Lex::next(ctx);
                                        create.int base = Ctx::get(ctx, 272);
                                        create.int calleeModOff = Ctx::get(ctx, 560);
                                        create.int calleeModLen = Ctx::get(ctx, 568);
                                        create.int calleeMemOff = Ctx::get(ctx, 576);
                                        create.int calleeMemLen = Ctx::get(ctx, 584);
                                        create.int argc = 0;
                                        create.int st = 1;
                                        if (Ctx::get(ctx, 72) == 35) { st = 2; }
                                        while (st == 1) {
                                            if (argc >= 4) {
                                                Parse::fail(ctx, 16);
                                                st = 0;
                                            } else {
                                                Ctx::set(ctx, 272, base + argc + 1);
                                                if (Expr::parse(ctx, 1) == 0) {
                                                    st = 0;
                                                } else {
                                                    Code::movSlotReg(ctx, base + argc, 0);
                                                    argc = argc + 1;
                                                    if (Ctx::get(ctx, 72) == 38) {
                                                        Lex::next(ctx);
                                                    } else {
                                                        st = 2;
                                                    }
                                                }
                                            }
                                        }
                                        if (st != 2) { return 0; }
                                        if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
                                        Ctx::set(ctx, 272, base);
                                        Ctx::set(ctx, 560, calleeModOff);
                                        Ctx::set(ctx, 568, calleeModLen);
                                        Ctx::set(ctx, 576, calleeMemOff);
                                        Ctx::set(ctx, 584, calleeMemLen);
                                        if (mode == 1) {
                                            if (Parse::callEmit(ctx, argc, base) == 0) { return 0; }
                                        } else {
                                            if (Parse::builtinEmit(ctx, argc, base) == 0) { return 0; }
                                        }
                                    }
                                } else {
                                    return Parse::fail(ctx, 12);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    while (1 == 1) {
        k = Ctx::get(ctx, 72);
        create.int p = Expr::prec(k);
        if (p == 0 || p < minPrec) { return 1; }
        if (k == 53 || k == 54) {
            Code::testRax(ctx);
            create.int j1 = 0;
            if (k == 53) {
                j1 = Code::jcc(ctx, 4);
            } else {
                j1 = Code::jcc(ctx, 5);
            }
            Lex::next(ctx);
            if (Expr::parse(ctx, p + 1) == 0) { return 0; }
            Code::testRax(ctx);
            Code::setccAl(ctx, 5);
            Code::movzxEaxAl(ctx);
            create.int j2 = Code::jmp(ctx);
            Code::patchRel(ctx, j1, Code::pos(ctx));
            if (k == 53) {
                Code::xorEax(ctx);
            } else {
                Code::movImm64(ctx, 0, 1);
            }
            Code::patchRel(ctx, j2, Code::pos(ctx));
            Ctx::set(ctx, 512, 0);
        } else {
            create.int slot = Ctx::get(ctx, 272);
            if (slot >= 64) { return Parse::fail(ctx, 37); }
            Code::movSlotReg(ctx, slot, 0);
            Ctx::set(ctx, 272, slot + 1);
            Lex::next(ctx);
            if (Expr::parse(ctx, p + 1) == 0) { return 0; }
            Ctx::set(ctx, 272, slot);
            Code::movRegSlot(ctx, 1, slot);
            if (k == 47) {
                Code::addRegReg(ctx, 0, 1);
                Ctx::set(ctx, 512, 0);
            } else {
                if (k == 48) {
                    Code::subRegReg(ctx, 1, 0);
                    Code::movRegReg(ctx, 0, 1);
                    Ctx::set(ctx, 512, 0);
                } else {
                    if (k == 49) {
                        Code::imulRegReg(ctx, 0, 1);
                        Ctx::set(ctx, 512, 0);
                    } else {
                        if (k == 50 || k == 51) {
                            Code::testRax(ctx);
                            Code::jccTo(ctx, 4, Ctx::get(ctx, 456));
                            Code::movRegReg(ctx, 2, 0);
                            Code::movRegReg(ctx, 0, 1);
                            Code::movRegReg(ctx, 1, 2);
                            Code::idivRcx(ctx);
                            if (k == 51) {
                                Code::movRegReg(ctx, 0, 2);
                            }
                            Ctx::set(ctx, 512, 0);
                        } else {
                            Code::cmpRcxRax(ctx);
                            if (k == 41) { Code::setccAl(ctx, 4); }
                            if (k == 42) { Code::setccAl(ctx, 5); }
                            if (k == 43) { Code::setccAl(ctx, 12); }
                            if (k == 44) { Code::setccAl(ctx, 15); }
                            if (k == 45) { Code::setccAl(ctx, 14); }
                            if (k == 46) { Code::setccAl(ctx, 13); }
                            Code::movzxEaxAl(ctx);
                            Ctx::set(ctx, 512, 0);
                        }
                    }
                }
            }
        }
    }
    return 1;
}

create.mod Parse::valueType(ptr.int ctx).int {
    create.int k = Ctx::get(ctx, 72);
    if (k == 12) {
        Lex::next(ctx);
        return 0;
    }
    if (k == 13) {
        Lex::next(ctx);
        return 1;
    }
    if (k == 15) {
        Lex::next(ctx);
        return 3;
    }
    if (k == 58) {
        Lex::next(ctx);
        return 0;
    }
    if (k == 14) {
        Lex::next(ctx);
        if (Parse::expect(ctx, 31, 2) == 0) { return 0 - 1; }
        if (Parse::expect(ctx, 12, 11) == 0) { return 0 - 1; }
        return 2;
    }
    Parse::fail(ctx, 11);
    return 0 - 1;
}

create.mod Parse::retType(ptr.int ctx).int {
    create.int k = Ctx::get(ctx, 72);
    if (k == 12) { Lex::next(ctx); return 0; }
    if (k == 13) { Lex::next(ctx); return 1; }
    if (k == 15) { Lex::next(ctx); return 3; }
    if (k == 58) { Lex::next(ctx); return 0; }
    Parse::fail(ctx, 31);
    return 0 - 1;
}

create.mod Parse::var(ptr.int ctx).int {
    Lex::next(ctx);
    if (Parse::expect(ctx, 31, 2) == 0) { return 0; }
    create.int ty = Parse::valueType(ctx);
    if (ty < 0) { return 0; }
    if (Ctx::get(ctx, 72) != 2) { return Parse::fail(ctx, 4); }
    Ident::saveTo(ctx, 560);
    Lex::next(ctx);
    create.int arrLen = 0;
    if (Ctx::get(ctx, 72) == 36) {
        Lex::next(ctx);
        if (Ctx::get(ctx, 72) != 3) { return Parse::fail(ctx, 36); }
        arrLen = Ctx::get(ctx, 96);
        Lex::next(ctx);
        if (Parse::expect(ctx, 37, 7) == 0) { return 0; }
        if (arrLen <= 0 || arrLen > 65536) { return Parse::fail(ctx, 21); }
    }
    create.int idx = Loc::addAt(ctx, ty, arrLen, 560);
    if (idx < 0) { return 0; }
    create.int slot = Loc::get(ctx, idx, 16);
    create.int width = 1;
    if (arrLen > 0) { width = arrLen; }
    create.int j = 0;
    while (j < width) {
        Code::movSlotImm(ctx, slot + j, 0);
        j = j + 1;
    }
    if (Ctx::get(ctx, 72) == 40) {
        Lex::next(ctx);
        if (arrLen > 0) {
            if (Ctx::get(ctx, 72) != 32) { return Parse::fail(ctx, 8); }
            Lex::next(ctx);
            create.int e = 0;
            create.int more = 1;
            if (Ctx::get(ctx, 72) == 33) { more = 0; }
            while (more == 1) {
                if (e >= arrLen) { return Parse::fail(ctx, 23); }
                if (Expr::parse(ctx, 1) == 0) { return 0; }
                if (Ctx::get(ctx, 512) != 0) { return Parse::fail(ctx, 26); }
                Code::movSlotReg(ctx, slot + arrLen - 1 - e, 0);
                e = e + 1;
                if (Ctx::get(ctx, 72) == 38) {
                    Lex::next(ctx);
                } else {
                    more = 0;
                }
            }
            if (Parse::expect(ctx, 33, 9) == 0) { return 0; }
        } else {
            if (Expr::parse(ctx, 1) == 0) { return 0; }
            if (Ty::compat(ty, Ctx::get(ctx, 512)) == 0) { return Parse::fail(ctx, 26); }
            Code::movSlotReg(ctx, slot, 0);
        }
    }
    return Parse::expect(ctx, 39, 10);
}

create.mod Parse::emitStmt(ptr.int ctx).int {
    Lex::next(ctx);
    if (Parse::expect(ctx, 31, 2) == 0) { return 0; }
    if (Parse::expect(ctx, 23, 3) == 0) { return 0; }
    while (1 == 1) {
        if (Parse::expect(ctx, 30, 5) == 0) { return 0; }
        if (Expr::parse(ctx, 1) == 0) { return 0; }
        Code::movRegReg(ctx, 2, 0);
        create.int fmt = 512;
        if (Ctx::get(ctx, 512) == 1) { fmt = 528; }
        create.int p = Code::leaRip(ctx, 1);
        Fix::addData(ctx, p, fmt);
        Code::xorEax(ctx);
        Code::callIat(ctx, 0);
        if (Ctx::get(ctx, 72) != 30) {
            return Parse::expect(ctx, 39, 10);
        }
    }
    return 1;
}

create.mod Parse::ret(ptr.int ctx).int {
    Lex::next(ctx);
    create.int rt = Ctx::get(ctx, 296);
    if (Ctx::get(ctx, 72) == 39) {
        Lex::next(ctx);
        Code::xorEax(ctx);
    } else {
        if (Expr::parse(ctx, 1) == 0) { return 0; }
        if (rt == 4) { return Parse::fail(ctx, 26); }
        if (Ty::compat(rt, Ctx::get(ctx, 512)) == 0) { return Parse::fail(ctx, 26); }
        if (Parse::expect(ctx, 39, 10) == 0) { return 0; }
    }
    Code::movRspRbp(ctx);
    Code::popRbp(ctx);
    Code::ret(ctx);
    return 1;
}

create.mod Parse::ifStmt(ptr.int ctx).int {
    Lex::next(ctx);
    if (Parse::expect(ctx, 34, 6) == 0) { return 0; }
    if (Expr::parse(ctx, 1) == 0) { return 0; }
    if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
    Code::testRax(ctx);
    create.int j = Code::jcc(ctx, 4);
    if (Parse::expect(ctx, 32, 8) == 0) { return 0; }
    return Parse::push(ctx, 1, j, 0);
}

create.mod Parse::whileStmt(ptr.int ctx).int {
    Lex::next(ctx);
    if (Parse::expect(ctx, 34, 6) == 0) { return 0; }
    create.int skip = Code::jmp(ctx);
    create.int brk = Code::jmp(ctx);
    create.int start = Code::pos(ctx);
    Code::patchRel(ctx, skip, start);
    if (Expr::parse(ctx, 1) == 0) { return 0; }
    if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
    Code::testRax(ctx);
    create.int j = Code::jcc(ctx, 4);
    if (Parse::expect(ctx, 32, 8) == 0) { return 0; }
    if (Parse::push(ctx, 3, j, start) == 0) { return 0; }
    Blk::set(ctx, Ctx::get(ctx, 520) - 1, 24, brk - 1);
    return 1;
}

create.mod Parse::identStmt(ptr.int ctx).int {
    create.int idx = Loc::findCur(ctx);
    Ident::saveTo(ctx, 560);
    Lex::next(ctx);
    if (idx >= 0) {
        create.int slot = Loc::get(ctx, idx, 16);
        create.int arrLen = Loc::get(ctx, idx, 24);
        create.int ty = Loc::get(ctx, idx, 32);
        if (Ctx::get(ctx, 72) == 55 || Ctx::get(ctx, 72) == 56) {
            if (arrLen > 0) { return Parse::fail(ctx, 25); }
            Code::movRegSlot(ctx, 0, slot);
            if (Ctx::get(ctx, 72) == 55) {
                Code::addRaxImm8(ctx, 1);
            } else {
                Code::addRaxImm8(ctx, 255);
            }
            Code::movSlotReg(ctx, slot, 0);
            Lex::next(ctx);
            return Parse::expect(ctx, 39, 10);
        }
        if (Ctx::get(ctx, 72) == 40) {
            if (arrLen > 0) { return Parse::fail(ctx, 25); }
            Lex::next(ctx);
            if (Expr::parse(ctx, 1) == 0) { return 0; }
            if (Ty::compat(ty, Ctx::get(ctx, 512)) == 0) { return Parse::fail(ctx, 26); }
            Code::movSlotReg(ctx, slot, 0);
            return Parse::expect(ctx, 39, 10);
        }
        if (Ctx::get(ctx, 72) == 36) {
            if (arrLen <= 0) { return Parse::fail(ctx, 25); }
            Lex::next(ctx);
            if (Expr::parse(ctx, 1) == 0) { return 0; }
            if (Parse::expect(ctx, 37, 7) == 0) { return 0; }
            Code::cmpRaxImm(ctx, arrLen);
            Code::jccTo(ctx, 3, Ctx::get(ctx, 464));
            create.int islot = Ctx::get(ctx, 272);
            if (islot >= 64) { return Parse::fail(ctx, 37); }
            Code::movSlotReg(ctx, islot, 0);
            Ctx::set(ctx, 272, islot + 1);
            if (Parse::expect(ctx, 40, 24) == 0) { return 0; }
            if (Expr::parse(ctx, 1) == 0) { return 0; }
            Ctx::set(ctx, 272, islot);
            if (Ctx::get(ctx, 512) != 0) { return Parse::fail(ctx, 26); }
            Code::leaSlotOff(ctx, 1, slot, (arrLen - 1) * 8);
            Code::movRegSlot(ctx, 2, islot);
            Code::storeElem(ctx);
            return Parse::expect(ctx, 39, 10);
        }
        return Parse::fail(ctx, 25);
    }
    create.int mode = 1;
    if (Ctx::get(ctx, 72) == 30) {
        Lex::next(ctx);
        if (Ctx::get(ctx, 72) != 2) { return Parse::fail(ctx, 4); }
        Ident::saveTo(ctx, 576);
        Lex::next(ctx);
    } else {
        if (Ctx::get(ctx, 72) == 34 && Ident::isBuiltinTok(ctx, 560) == 1) {
            mode = 2;
        } else {
            return Parse::fail(ctx, 13);
        }
    }
    if (Ctx::get(ctx, 72) != 34) { return Parse::fail(ctx, 6); }
    Lex::next(ctx);
    create.int base = Ctx::get(ctx, 272);
    create.int calleeModOff = Ctx::get(ctx, 560);
    create.int calleeModLen = Ctx::get(ctx, 568);
    create.int calleeMemOff = Ctx::get(ctx, 576);
    create.int calleeMemLen = Ctx::get(ctx, 584);
    create.int argc = 0;
    create.int st = 1;
    if (Ctx::get(ctx, 72) == 35) { st = 2; }
    while (st == 1) {
        if (argc >= 4) {
            Parse::fail(ctx, 16);
            st = 0;
        } else {
            Ctx::set(ctx, 272, base + argc + 1);
            if (Expr::parse(ctx, 1) == 0) {
                st = 0;
            } else {
                Code::movSlotReg(ctx, base + argc, 0);
                argc = argc + 1;
                if (Ctx::get(ctx, 72) == 38) {
                    Lex::next(ctx);
                } else {
                    st = 2;
                }
            }
        }
    }
    if (st != 2) { return 0; }
    if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
    Ctx::set(ctx, 272, base);
    Ctx::set(ctx, 560, calleeModOff);
    Ctx::set(ctx, 568, calleeModLen);
    Ctx::set(ctx, 576, calleeMemOff);
    Ctx::set(ctx, 584, calleeMemLen);
    if (mode == 1) {
        if (Parse::callEmit(ctx, argc, base) == 0) { return 0; }
    } else {
        if (Parse::builtinEmit(ctx, argc, base) == 0) { return 0; }
    }
    return Parse::expect(ctx, 39, 10);
}

create.mod Parse::stepExpr(ptr.int ctx).int {
    if (Ctx::get(ctx, 72) == 2) {
        create.int idx = Loc::findCur(ctx);
        if (idx >= 0) {
            create.int slot = Loc::get(ctx, idx, 16);
            create.int arrLen = Loc::get(ctx, idx, 24);
            create.int ty = Loc::get(ctx, idx, 32);
            create.int next = Ctx::get(ctx, 128);
            if (arrLen == 0 && (next == 55 || next == 56)) {
                create.int op = next;
                Lex::next(ctx);
                Lex::next(ctx);
                Code::movRegSlot(ctx, 0, slot);
                if (op == 55) {
                    Code::addRaxImm8(ctx, 1);
                } else {
                    Code::addRaxImm8(ctx, 255);
                }
                Code::movSlotReg(ctx, slot, 0);
                Ctx::set(ctx, 512, 0);
                return 1;
            }
            if (arrLen == 0 && next == 40) {
                Lex::next(ctx);
                Lex::next(ctx);
                if (Expr::parse(ctx, 1) == 0) { return 0; }
                if (Ty::compat(ty, Ctx::get(ctx, 512)) == 0) { return Parse::fail(ctx, 26); }
                Code::movSlotReg(ctx, slot, 0);
                return 1;
            }
        }
    }
    return Expr::parse(ctx, 1);
}

create.mod Parse::forStmt(ptr.int ctx).int {
    Lex::next(ctx);
    create.int hasParen = 0;
    if (Ctx::get(ctx, 72) == 34) {
        hasParen = 1;
        Lex::next(ctx);
    }
    create.int savedLocals = Ctx::get(ctx, 256);
    create.int savedTop = Ctx::get(ctx, 280);
    if (Ctx::get(ctx, 72) == 39) {
        Lex::next(ctx);
    } else {
        if (Ctx::get(ctx, 72) == 10) {
            if (Parse::var(ctx) == 0) { return 0; }
        } else {
            if (Ctx::get(ctx, 72) == 43 && Ctx::get(ctx, 128) == 2) {
                Lex::next(ctx);
                Ident::saveTo(ctx, 560);
                Lex::next(ctx);
                create.int idx = Loc::addAt(ctx, 0, 0, 560);
                if (idx < 0) { return 0; }
                create.int slot = Loc::get(ctx, idx, 16);
                if (Ctx::get(ctx, 72) == 40) {
                    Lex::next(ctx);
                    if (Expr::parse(ctx, 5) == 0) { return 0; }
                    if (Ctx::get(ctx, 512) != 0) { return Parse::fail(ctx, 26); }
                    Code::movSlotReg(ctx, slot, 0);
                } else {
                    Code::movSlotImm(ctx, slot, 1);
                }
                if (Parse::expect(ctx, 44, 7) == 0) { return 0; }
                if (Parse::expect(ctx, 39, 10) == 0) { return 0; }
            } else {
                if (Ctx::get(ctx, 72) == 2) {
                    if (Parse::identStmt(ctx) == 0) { return 0; }
                } else {
                    return Parse::fail(ctx, 12);
                }
            }
        }
    }
    create.int start = Code::pos(ctx);
    create.int j = 0;
    if (Ctx::get(ctx, 72) != 39) {
        if (Expr::parse(ctx, 1) == 0) { return 0; }
        Code::testRax(ctx);
        j = Code::jcc(ctx, 4);
    }
    if (Parse::expect(ctx, 39, 10) == 0) { return 0; }
    create.int skip = Code::jmp(ctx);
    create.int cont = Code::pos(ctx);
    if (Ctx::get(ctx, 72) != 35 && Ctx::get(ctx, 72) != 32) {
        if (Parse::stepExpr(ctx) == 0) { return 0; }
    }
    Code::jmpTo(ctx, start);
    create.int brk = Code::jmp(ctx);
    Code::patchRel(ctx, skip, Code::pos(ctx));
    if (hasParen == 1) {
        if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
    }
    if (Parse::expect(ctx, 32, 8) == 0) { return 0; }
    if (Parse::push(ctx, 7, j, cont) == 0) { return 0; }
    create.int d = Ctx::get(ctx, 520) - 1;
    Blk::set(ctx, d, 8, savedLocals);
    Blk::set(ctx, d, 24, brk - 1);
    Blk::set(ctx, d, 56, savedTop);
    return 1;
}

create.mod Parse::loopStmt(ptr.int ctx).int {
    Lex::next(ctx);
    create.int count = 0;
    create.int hasCount = 0;
    if (Ctx::get(ctx, 72) == 34) {
        Lex::next(ctx);
        if (Ctx::get(ctx, 72) == 3) {
            count = Ctx::get(ctx, 96);
            hasCount = 1;
            Lex::next(ctx);
        }
        if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
    }
    create.int savedLocals = Ctx::get(ctx, 256);
    create.int savedTop = Ctx::get(ctx, 280);
    create.int counter = 0;
    if (hasCount == 1) {
        counter = 68 + Ctx::get(ctx, 280);
        Ctx::set(ctx, 280, Ctx::get(ctx, 280) + 1);
        Code::movSlotImm(ctx, counter, count);
    }
    create.int skip = Code::jmp(ctx);
    create.int cont = 0;
    if (hasCount == 1) {
        cont = Code::jmp(ctx);
    }
    create.int brk = Code::jmp(ctx);
    create.int start = Code::pos(ctx);
    Code::patchRel(ctx, skip, start);
    create.int j = 0;
    if (hasCount == 1) {
        Code::movRegSlot(ctx, 0, counter);
        Code::testRax(ctx);
        j = Code::jcc(ctx, 14);
    }
    if (Parse::expect(ctx, 32, 8) == 0) { return 0; }
    create.int kind = 9;
    if (hasCount == 1) { kind = 8; }
    if (Parse::push(ctx, kind, j, start) == 0) { return 0; }
    create.int d = Ctx::get(ctx, 520) - 1;
    Blk::set(ctx, d, 8, savedLocals);
    Blk::set(ctx, d, 24, brk - 1);
    Blk::set(ctx, d, 56, savedTop);
    if (hasCount == 1) {
        Blk::set(ctx, d, 32, cont - 1);
        Blk::set(ctx, d, 40, start);
        Blk::set(ctx, d, 48, counter);
    }
    return 1;
}

create.mod Parse::loopDepth(ptr.int ctx).int {
    create.int d = Ctx::get(ctx, 520) - 1;
    while (d >= 0) {
        create.int k = Blk::get(ctx, d, 0);
        if (k == 3 || k == 7 || k == 8 || k == 9) {
            return d;
        }
        d = d - 1;
    }
    return 0 - 1;
}

create.mod Parse::breakStmt(ptr.int ctx).int {
    Lex::next(ctx);
    create.int d = Parse::loopDepth(ctx);
    if (d < 0) { return Parse::fail(ctx, 12); }
    Code::jmpTo(ctx, Blk::get(ctx, d, 24));
    return Parse::expect(ctx, 39, 10);
}

create.mod Parse::continueStmt(ptr.int ctx).int {
    Lex::next(ctx);
    create.int d = Parse::loopDepth(ctx);
    if (d < 0) { return Parse::fail(ctx, 12); }
    Code::jmpTo(ctx, Blk::get(ctx, d, 32));
    return Parse::expect(ctx, 39, 10);
}

create.mod Parse::stmt(ptr.int ctx).int {
    create.int k = Ctx::get(ctx, 72);
    if (k == 10) { return Parse::var(ctx); }
    if (k == 22) { return Parse::emitStmt(ctx); }
    if (k == 19) { return Parse::ret(ctx); }
    if (k == 16) { return Parse::ifStmt(ctx); }
    if (k == 18) { return Parse::whileStmt(ctx); }
    if (k == 26) { return Parse::forStmt(ctx); }
    if (k == 27 || k == 28) { return Parse::loopStmt(ctx); }
    if (k == 24) { return Parse::breakStmt(ctx); }
    if (k == 25) { return Parse::continueStmt(ctx); }
    if (k == 32) {
        Lex::next(ctx);
        return Parse::push(ctx, 4, 0, 0);
    }
    if (k == 2) { return Parse::identStmt(ctx); }
    return Parse::fail(ctx, 12);
}

create.mod Parse::closeFn(ptr.int ctx, int depth, int saved).int {
    Lex::next(ctx);
    Code::movImm64(ctx, 0, 0);
    Code::movRspRbp(ctx);
    Code::popRbp(ctx);
    Code::ret(ctx);
    create.int fs = Num::alignUp(8 * (68 + Ctx::get(ctx, 280)) + 32, 16);
    Code::patch32(ctx, Ctx::get(ctx, 288), fs);
    Ctx::set(ctx, 256, saved);
    Ctx::set(ctx, 520, depth);
    return 1;
}

create.mod Parse::closeIf(ptr.int ctx, int depth, int kind, int saved).int {
    Lex::next(ctx);
    Ctx::set(ctx, 256, saved);
    Ctx::set(ctx, 520, depth);
    if (kind == 1) {
        if (Ctx::get(ctx, 72) == 17) {
            Lex::next(ctx);
            create.int j2 = Code::jmp(ctx);
            Code::patchRel(ctx, Blk::get(ctx, depth, 16), Code::pos(ctx));
            if (Parse::expect(ctx, 32, 8) == 0) { return 0; }
            if (Parse::push(ctx, 2, j2, 0) == 0) { return 0; }
        } else {
            Code::patchRel(ctx, Blk::get(ctx, depth, 16), Code::pos(ctx));
        }
        return 1;
    }
    Code::patchRel(ctx, Blk::get(ctx, depth, 16), Code::pos(ctx));
    return 1;
}

create.mod Parse::closeLoop(ptr.int ctx, int depth, int kind, int saved).int {
    Lex::next(ctx);
    if (kind == 3 || kind == 7) {
        Code::jmpTo(ctx, Blk::get(ctx, depth, 32));
        create.int end = Code::pos(ctx);
        if (Blk::get(ctx, depth, 16) != 0) {
            Code::patchRel(ctx, Blk::get(ctx, depth, 16), end);
        }
        Code::patchRel(ctx, Blk::get(ctx, depth, 24) + 1, end);
    } else {
        if (kind == 8) {
            create.int decPos = Code::pos(ctx);
            Code::patchRel(ctx, Blk::get(ctx, depth, 32) + 1, decPos);
            create.int counter = Blk::get(ctx, depth, 48);
            Code::movRegSlot(ctx, 0, counter);
            Code::addRaxImm8(ctx, 255);
            Code::movSlotReg(ctx, counter, 0);
            Code::jmpTo(ctx, Blk::get(ctx, depth, 40));
            create.int end = Code::pos(ctx);
            Code::patchRel(ctx, Blk::get(ctx, depth, 16), end);
            Code::patchRel(ctx, Blk::get(ctx, depth, 24) + 1, end);
        } else {
            if (kind == 9) {
                Code::jmpTo(ctx, Blk::get(ctx, depth, 32));
                create.int end = Code::pos(ctx);
                Code::patchRel(ctx, Blk::get(ctx, depth, 24) + 1, end);
            } else {
                Ctx::set(ctx, 256, saved);
                Ctx::set(ctx, 520, depth);
                return 1;
            }
        }
    }
    Ctx::set(ctx, 256, saved);
    Ctx::set(ctx, 280, Blk::get(ctx, depth, 56));
    Ctx::set(ctx, 520, depth);
    return 1;
}

create.mod Parse::body(ptr.int ctx, int fnIdx).int {
    if (Parse::expect(ctx, 32, 8) == 0) { return 0; }
    Ctx::set(ctx, 272, 0);
    if (Parse::push(ctx, 0, 0, 0) == 0) { return 0; }
    while (1 == 1) {
        create.int k = Ctx::get(ctx, 72);
        if (k == 0) { return Parse::fail(ctx, 9); }
        if (k == 33) {
            create.int depth = Ctx::get(ctx, 520) - 1;
            create.int kind = Blk::get(ctx, depth, 0);
            create.int saved = Blk::get(ctx, depth, 8);
            if (kind == 0) {
                return Parse::closeFn(ctx, depth, saved);
            }
            if (kind == 1 || kind == 2) {
                if (Parse::closeIf(ctx, depth, kind, saved) == 0) { return 0; }
            } else {
                if (kind == 3 || kind == 7 || kind == 8 || kind == 9) {
                    if (Parse::closeLoop(ctx, depth, kind, saved) == 0) { return 0; }
                } else {
                    Lex::next(ctx);
                    Ctx::set(ctx, 256, saved);
                    Ctx::set(ctx, 520, depth);
                }
            }
        } else {
            if (Parse::stmt(ctx) == 0) { return 0; }
        }
    }
    return 1;
}

create.mod Parse::fnDecl(ptr.int ctx).int {
    if (Parse::expect(ctx, 10, 1) == 0) { return 0; }
    if (Parse::expect(ctx, 31, 2) == 0) { return 0; }
    if (Parse::expect(ctx, 11, 3) == 0) { return 0; }
    if (Ctx::get(ctx, 72) != 2) { return Parse::fail(ctx, 4); }
    Ident::saveTo(ctx, 560);
    Lex::next(ctx);
    if (Parse::expect(ctx, 30, 5) == 0) { return 0; }
    if (Ctx::get(ctx, 72) != 2) { return Parse::fail(ctx, 4); }
    Ident::saveTo(ctx, 576);
    Lex::next(ctx);
    if (Parse::expect(ctx, 34, 6) == 0) { return 0; }
    Ctx::set(ctx, 256, 0);
    Ctx::set(ctx, 280, 0);
    Ctx::set(ctx, 272, 0);
    create.int pc = 0;
    create.int more = 1;
    if (Ctx::get(ctx, 72) == 35) { more = 0; }
    while (more == 1) {
        if (pc >= 4) { return Parse::fail(ctx, 15); }
        create.int pty = Parse::valueType(ctx);
        if (pty < 0) { return 0; }
        if (Ctx::get(ctx, 72) != 2) { return Parse::fail(ctx, 4); }
        create.int pi = Loc::addParamAt(ctx, pty, pc, 80);
        if (pi < 0) { return 0; }
        pc = pc + 1;
        Lex::next(ctx);
        if (Ctx::get(ctx, 72) == 38) {
            Lex::next(ctx);
        } else {
            more = 0;
        }
    }
    if (Parse::expect(ctx, 35, 7) == 0) { return 0; }
    create.int rt = 4;
    if (Ctx::get(ctx, 72) == 31) {
        Lex::next(ctx);
        rt = Parse::retType(ctx);
        if (rt < 0) { return 0; }
    }
    if (Fn::findSaved(ctx) >= 0) { return Parse::fail(ctx, 19); }
    create.int codePos = Code::pos(ctx);
    create.int fidx = Fn::add(ctx, Ctx::get(ctx, 560), Ctx::get(ctx, 576), codePos);
    if (fidx < 0) { return 0; }
    Fn::set(ctx, fidx, 8, Ctx::get(ctx, 568));
    Fn::set(ctx, fidx, 24, Ctx::get(ctx, 584));
    Fn::set(ctx, fidx, 40, pc);
    Fn::set(ctx, fidx, 80, rt);
    create.int q = 0;
    while (q < pc) {
        Fn::set(ctx, fidx, 48 + q * 8, Loc::get(ctx, q, 32));
        q = q + 1;
    }
    if (Ident::eqTok(ctx, 560, "Main") == 1 && Ident::eqTok(ctx, 576, "main") == 1) {
        if (pc != 0) { return Parse::fail(ctx, 15); }
        Ctx::set(ctx, 368, 1);
        Ctx::set(ctx, 528, codePos);
    }
    Ctx::set(ctx, 296, rt);
    Code::pushRbp(ctx);
    Code::movRbpRsp(ctx);
    Ctx::set(ctx, 288, Code::subRspPlaceholder(ctx));
    if (pc > 0) { Code::movSlotReg(ctx, 64, 1); }
    if (pc > 1) { Code::movSlotReg(ctx, 65, 2); }
    if (pc > 2) { Code::movSlotReg(ctx, 66, 8); }
    if (pc > 3) { Code::movSlotReg(ctx, 67, 9); }
    if (Parse::body(ctx, fidx) == 0) { return 0; }
    Fn::set(ctx, fidx, 88, 1);
    Ctx::set(ctx, 256, 0);
    Ctx::set(ctx, 280, 0);
    Ctx::set(ctx, 272, 0);
    return 1;
}

create.mod Parse::program(ptr.int ctx).int {
    while (Ctx::get(ctx, 72) != 0) {
        if (Ctx::get(ctx, 72) == 1) { return 0; }
        if (Parse::fnDecl(ctx) == 0) { return 0; }
    }
    if (Ctx::get(ctx, 368) == 0) { return Parse::fail(ctx, 28); }
    return 1;
}

// Keep this as a direct-return helper: stage0 miscompiles a loop-carried
// boolean flag in large functions (see src/BOOTSTRAP.md section 6.1).
create.mod Cli::stdOk(char opt).int {
    if (Str::eqRest(opt, 5, "wei27") == 1) {
        return 1;
    }
    if (Str::eqRest(opt, 5, "wei") == 1) {
        return 1;
    }
    if (Str::eqRest(opt, 5, "default") == 1) {
        return 1;
    }
    return 0;
}

create.mod Msg::missing(char name) {
    create.ptr.int raw = Mem::alloc(512);
    create.char msg = Cast::text(raw);
    create.int n = Str::append(msg, 0, 512, "error: subcommand '");
    n = Str::append(msg, n, 512, name);
    Str::append(msg, n, 512, "' requires a file");
    do.emit::msg;
    Mem::free(raw);
}

create.mod Msg::unknown(char name) {
    create.ptr.int raw = Mem::alloc(512);
    create.char msg = Cast::text(raw);
    create.int n = Str::append(msg, 0, 512, "error: unknown subcommand '");
    n = Str::append(msg, n, 512, name);
    Str::append(msg, n, 512, "'");
    do.emit::msg;
    do.emit::"usage: bootstrap build <file.wei> [-o out.exe] [-std:wei27]";
    Mem::free(raw);
}

create.mod Main::main() {
    create.int argc = Cmd::argc();
    create.ptr.int rawA1 = Mem::alloc(64);
    create.char a1 = Cast::text(rawA1);
    create.ptr.int rawFile = Mem::alloc(4096);
    create.char file = Cast::text(rawFile);
    create.ptr.int rawOpt = Mem::alloc(4096);
    create.char opt = Cast::text(rawOpt);
    create.ptr.int rawOut = Mem::alloc(4096);
    create.char out = Cast::text(rawOut);
    create.int outSet = 0;
    create.int i = 3;

    if (argc <= 1) {
        do.emit::"Module Target Generator - bootstrap stage1";
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        return;
    }

    Cmd::arg(1, a1, 64);
    if (Str::eq(a1, "version") == 1 || Str::eq(a1, "-v") == 1 || Str::eq(a1, "--version") == 1) {
        do.emit::"Module Target Generator 0.02.74282 - bootstrap stage1 (win64)";
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        return;
    }

    if (Str::eq(a1, "build") == 0) {
        if (argc < 3) {
            Msg::missing(a1);
            Mem::free(rawA1);
            Mem::free(rawFile);
            Mem::free(rawOpt);
            Mem::free(rawOut);
            __exit(2);
            return;
        }
        Msg::unknown(a1);
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        __exit(2);
        return;
    }

    if (argc < 3) {
        do.emit::"error: subcommand 'build' requires a file";
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        __exit(2);
        return;
    }

    Cmd::arg(2, file, 4096);

    while (i < argc) {
        Cmd::arg(i, opt, 4096);
        if (Str::eq(opt, "-o") == 1) {
            i = i + 1;
            if (i >= argc) {
                do.emit::"error: option '-o' requires a value";
                Mem::free(rawA1);
                Mem::free(rawFile);
                Mem::free(rawOpt);
                Mem::free(rawOut);
                __exit(2);
                return;
            }
            Cmd::arg(i, out, 4096);
            outSet = 1;
        } else {
            if (Str::starts(opt, "-std:") == 1) {
                if (Cli::stdOk(opt) == 0) {
                    do.emit::"error: unsupported -std value";
                    Mem::free(rawA1);
                    Mem::free(rawFile);
                    Mem::free(rawOpt);
                    Mem::free(rawOut);
                    __exit(2);
                    return;
                }
            } else {
                if (Str::eq(opt, "-target") == 1) {
                    i = i + 1;
                    if (i >= argc) {
                        do.emit::"error: option '-target' requires a value";
                        Mem::free(rawA1);
                        Mem::free(rawFile);
                        Mem::free(rawOpt);
                        Mem::free(rawOut);
                        __exit(2);
                        return;
                    }
                    Cmd::arg(i, opt, 4096);
                    if (Str::eq(opt, "win64") == 0) {
                        do.emit::"error: target is not supported";
                        Mem::free(rawA1);
                        Mem::free(rawFile);
                        Mem::free(rawOpt);
                        Mem::free(rawOut);
                        __exit(2);
                        return;
                    }
                } else {
                    if (Str::eq(opt, "-wide") == 1 || Str::starts(opt, "-emit-norm:") == 1) {
                        do.emit::"error: option is not supported";
                        Mem::free(rawA1);
                        Mem::free(rawFile);
                        Mem::free(rawOpt);
                        Mem::free(rawOut);
                        __exit(2);
                        return;
                    }
                }
            }
        }
        i = i + 1;
    }

    if (outSet == 0) {
        Path::outName(file, out, 4096);
    }

    create.ptr.int src = Mem::alloc(1048577);
    create.int n = __read_file(file, src, 1048577);
    if (n <= 0) {
        Msg::fileErr(file, "cannot read source file (missing or empty)");
        Mem::free(src);
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        __exit(1);
        return;
    }
    if (n > 1048576) {
        Msg::fileErr(file, "source exceeds 1048576 bytes");
        Mem::free(src);
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        __exit(1);
        return;
    }
    __store_byte(src, n, 0);

    create.ptr.int ctxRaw = Mem::alloc(131072);
    create.ptr.int ctx = ctxRaw;
    create.ptr.int dataRaw = Mem::alloc(1048576);
    create.ptr.int data = dataRaw;
    create.ptr.int codeRaw = Mem::alloc(4194304);
    create.ptr.int code = codeRaw;
    create.ptr.int outRaw = Mem::alloc(8388608);
    create.ptr.int outBuf = outRaw;
    create.ptr.int fixRaw = Mem::alloc(1048576);
    create.ptr.int fix = fixRaw;
    create.ptr.int iatRaw = Mem::alloc(1048576);
    create.ptr.int iat = iatRaw;
    create.ptr.int funcRaw = Mem::alloc(65536);
    create.ptr.int funcs = funcRaw;
    create.ptr.int localRaw = Mem::alloc(65536);
    create.ptr.int locals = localRaw;

    Data::init(ctx, data, 1048576);
    Code::init(ctx, code, 4194304);
    Fix::init(ctx, fix, iat);
    Ctx::set(ctx, 232, Cast::num(funcs));
    Ctx::set(ctx, 240, 0);
    Ctx::set(ctx, 248, Cast::num(locals));
    Ctx::set(ctx, 256, 0);
    Ctx::set(ctx, 264, 0);
    Ctx::set(ctx, 272, 0);
    Ctx::set(ctx, 280, 0);
    Ctx::set(ctx, 296, 4);
    Ctx::set(ctx, 368, 0);
    Ctx::set(ctx, 432, Cast::num(out));
    Ctx::set(ctx, 440, Cast::num(outBuf));
    Ctx::set(ctx, 448, 8388608);
    Ctx::set(ctx, 456, 0);
    Ctx::set(ctx, 464, 0);
    Ctx::set(ctx, 472, 0);
    Ctx::set(ctx, 480, 0);
    Ctx::set(ctx, 488, 0);
    Ctx::set(ctx, 496, 0);
    Ctx::set(ctx, 504, 0);
    Ctx::set(ctx, 512, 0);
    Ctx::set(ctx, 520, 0);
    Rt::init(ctx);
    Lex::init(ctx, src, n);
    if (Ctx::get(ctx, 72) == 1) {
        Err::report(ctx, file);
        Mem::free(localRaw);
        Mem::free(funcRaw);
        Mem::free(iatRaw);
        Mem::free(fixRaw);
        Mem::free(outRaw);
        Mem::free(codeRaw);
        Mem::free(dataRaw);
        Mem::free(ctxRaw);
        Mem::free(src);
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        __exit(1);
        return;
    }
    if (Parse::program(ctx) == 0) {
        Err::report(ctx, file);
        Mem::free(localRaw);
        Mem::free(funcRaw);
        Mem::free(iatRaw);
        Mem::free(fixRaw);
        Mem::free(outRaw);
        Mem::free(codeRaw);
        Mem::free(dataRaw);
        Mem::free(ctxRaw);
        Mem::free(src);
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        __exit(1);
        return;
    }
    create.int wrote = Pe::build(ctx, outBuf, 8388608, Ctx::get(ctx, 528));
    if (wrote == 0) {
        Msg::fileErr(file, "cannot write output file");
        Mem::free(localRaw);
        Mem::free(funcRaw);
        Mem::free(iatRaw);
        Mem::free(fixRaw);
        Mem::free(outRaw);
        Mem::free(codeRaw);
        Mem::free(dataRaw);
        Mem::free(ctxRaw);
        Mem::free(src);
        Mem::free(rawA1);
        Mem::free(rawFile);
        Mem::free(rawOpt);
        Mem::free(rawOut);
        __exit(1);
        return;
    }
    Msg::done(out);
    Mem::free(localRaw);
    Mem::free(funcRaw);
    Mem::free(iatRaw);
    Mem::free(fixRaw);
    Mem::free(outRaw);
    Mem::free(codeRaw);
    Mem::free(dataRaw);
    Mem::free(ctxRaw);
    Mem::free(src);
    Mem::free(rawA1);
    Mem::free(rawFile);
    Mem::free(rawOpt);
    Mem::free(rawOut);
    __exit(0);
    return;
}
